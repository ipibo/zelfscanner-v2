#!/usr/bin/env bash
# zsdeploy — push content-pack + app naar meerdere Zebra scanners (MC18N0 / PS20J)
# over adb/wifi, en zien of elk device echt dezelfde versie draait.
#
# Host: macOS (bash 3.2, BSD userland). Enige externe dependency: adb.
# Device-side shell: toolbox (Android 5.1.1 MC18N0). Geschreven voor de
# laagste gemene deler zodat het ook werkt op PS20J (Android 10).

set -euo pipefail
shopt -s nocasematch

# ============================================================
# CONFIG — pas hier aan, of override via env waar aangegeven
# ============================================================
ZS_APP_ID="${ZS_APP_ID:-com.zelfscannerv2}"          # package naam van de app. LEEG = niet gezet, faalt duidelijk waar nodig.
PACK_DIR_DEFAULT="pack"             # lokale content-pack map (override: push [pack-dir])
DEVICES_FILE="devices.txt"          # regels: "naam ip [story] [sn=serienummer]"   '#' = comment
STORIES_DIR="stories"               # story <naam> = stories/<naam>.json; geen story = manifest uit de pack-dir
REMOTE_BASE="/sdcard/zelfscanner"
REMOTE_PACK="$REMOTE_BASE/pack"
REMOTE_STAGING="$REMOTE_BASE/.staging"
REMOTE_PACK_OLD="$REMOTE_BASE/.pack_old"
ADB_PORT=5555
SCRIPT_NAME="$(basename "$0")"

# ============================================================
# KLEUR (alleen als stdout een tty is)
# ============================================================
if [ -t 1 ]; then
  C_RED=$'\033[31m'; C_GRN=$'\033[32m'; C_YLW=$'\033[33m'; C_BLU=$'\033[34m'
  C_BOLD=$'\033[1m'; C_RST=$'\033[0m'
else
  C_RED=""; C_GRN=""; C_YLW=""; C_BLU=""; C_BOLD=""; C_RST=""
fi

info(){ printf '%s\n' "$*"; }
ok(){ printf '%s[OK]%s %s\n' "$C_GRN" "$C_RST" "$*"; }
warn(){ printf '%s[WARN]%s %s\n' "$C_YLW" "$C_RST" "$*" >&2; }
err(){ printf '%s[FAIL]%s %s\n' "$C_RED" "$C_RST" "$*" >&2; }

# ============================================================
# TEMP + CLEANUP
# ============================================================
TMPDIR_ZS="$(mktemp -d "${TMPDIR:-/tmp}/zsdeploy.XXXXXX")"
cleanup(){ rm -rf "$TMPDIR_ZS"; }
trap cleanup EXIT INT TERM

sanitize(){ printf '%s' "${1//[:\/]/_}"; }

require_adb(){
  command -v adb >/dev/null 2>&1 || { err "adb niet gevonden in PATH. Installeer Android platform-tools."; exit 1; }
}

# ============================================================
# devices.txt
# ============================================================
# Een device wordt herkend aan zijn serienummer (getprop ro.serialno, sn=…)
# en pas als dat er niet staat aan zijn IP. IP's verschuiven via DHCP, het
# serienummer niet: zo blijft de story aan het juiste device hangen. Zie
# list_targets, die ook een verschoven IP in devices.txt bijwerkt.
DEV_NAMES=(); DEV_IPS=(); DEV_STORIES=(); DEV_SNS=()
load_devices_file(){
  DEV_NAMES=(); DEV_IPS=(); DEV_STORIES=(); DEV_SNS=()
  [ -f "$DEVICES_FILE" ] || return 0
  local line n ip story sn tok
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      ''|'#'*) continue ;;
    esac
    n="$(printf '%s' "$line" | awk '{print $1}')"
    ip="$(printf '%s' "$line" | awk '{print $2}')"
    [ -n "$n" ] && [ -n "$ip" ] || continue
    story=""; sn=""
    for tok in $(printf '%s' "$line" | awk '{for (i = 3; i <= NF; i++) print $i}'); do
      case "$tok" in
        sn=*) sn="${tok#sn=}" ;;
        *) [ -z "$story" ] && story="$tok" ;;
      esac
    done
    DEV_NAMES+=("$n"); DEV_IPS+=("$ip"); DEV_STORIES+=("${story:-standaard}"); DEV_SNS+=("$sn")
  done < "$DEVICES_FILE"
}

# index in DEV_* voor een naam, of -1
idx_for_name(){
  local target="$1" i
  for i in "${!DEV_NAMES[@]}"; do
    [ "${DEV_NAMES[$i]}" = "$target" ] && { printf '%s' "$i"; return 0; }
  done
  printf '%s' "-1"
}

name_for_serial(){
  local target="$1" i
  [ -n "$target" ] || { printf '%s' "-"; return 0; }
  for i in "${!DEV_SNS[@]}"; do
    [ "${DEV_SNS[$i]}" = "$target" ] && { printf '%s' "${DEV_NAMES[$i]}"; return 0; }
  done
  printf '%s' "-"
}

# Op IP, maar niet als die regel een ander serienummer heeft: dan is het IP
# inmiddels van een ander device.
name_for_ip(){
  local target="$1" hw="${2:-}" i
  for i in "${!DEV_IPS[@]}"; do
    [ "${DEV_IPS[$i]}" = "$target" ] || continue
    [ -n "$hw" ] && [ -n "${DEV_SNS[$i]}" ] && [ "${DEV_SNS[$i]}" != "$hw" ] && continue
    printf '%s' "${DEV_NAMES[$i]}"; return 0
  done
  printf '%s' "-"
}

# Naam van een live device: eerst op serienummer, dan op IP.
resolve_name(){
  local hw="$1" ip="$2" name
  name="$(name_for_serial "$hw")"
  [ "$name" = "-" ] && name="$(name_for_ip "$ip" "$hw")"
  printf '%s' "$name"
}

# Zet ip en serienummer van een device in devices.txt (regel op naam), story
# en volgorde blijven staan. Bestaat de naam niet, dan komt er een regel bij.
# Leeg sn = het bestaande serienummer houden.
update_device_entry(){
  local name="$1" ip="$2" sn="${3:-}" tmp="$TMPDIR_ZS/devices.txt.new"
  touch "$DEVICES_FILE"
  awk -v n="$name" -v ip="$ip" -v newsn="$sn" '
    $1 == n {
      story = ""; oldsn = ""
      for (i = 3; i <= NF; i++) {
        if ($i ~ /^sn=/) oldsn = substr($i, 4)
        else if (story == "") story = $i
      }
      useip = (ip != "") ? ip : $2
      line = n " " useip
      if (story != "") line = line " " story
      s = (newsn != "") ? newsn : oldsn
      if (s != "") line = line " sn=" s
      print line; found = 1; next
    }
    { print }
    END { if (!found) print n " " ip ((newsn != "") ? " sn=" newsn : "") }
  ' "$DEVICES_FILE" > "$tmp"
  mv "$tmp" "$DEVICES_FILE"
  load_devices_file
}

# story voor een device-naam ("standaard" als niet in devices.txt, bv. usb)
story_for_name(){
  local target="$1" i
  for i in "${!DEV_NAMES[@]}"; do
    [ "${DEV_NAMES[$i]}" = "$target" ] && { printf '%s' "${DEV_STORIES[$i]}"; return 0; }
  done
  printf 'standaard'
}

# manifest dat dit device moet krijgen: standaard = die uit de pack-dir
manifest_for_story(){
  local story="$1" pack_dir="$2"
  if [ "$story" = "standaard" ]; then
    printf '%s' "$pack_dir/manifest.json"
  else
    printf '%s' "$STORIES_DIR/$story.json"
  fi
}

# ============================================================
# adb helpers
# ============================================================
get_prop(){ adb -s "$1" shell getprop "$2" </dev/null 2>/dev/null | tr -d '\r\n' || true; }

ALL_SERIALS=(); ALL_STATUS=(); OFFLINE_SERIALS=(); UNAUTH_SERIALS=()
scan_adb_devices(){
  ALL_SERIALS=(); ALL_STATUS=(); OFFLINE_SERIALS=(); UNAUTH_SERIALS=()
  local line serial status
  while IFS= read -r line || [ -n "$line" ]; do
    case "$line" in
      "List of devices attached"*|'') continue ;;
    esac
    serial="$(printf '%s' "$line" | awk '{print $1}')"
    status="$(printf '%s' "$line" | awk '{print $2}')"
    [ -n "$serial" ] || continue
    ALL_SERIALS+=("$serial"); ALL_STATUS+=("$status")
    case "$status" in
      offline) OFFLINE_SERIALS+=("$serial") ;;
      unauthorized) UNAUTH_SERIALS+=("$serial") ;;
    esac
  done < <(adb devices </dev/null)
}

# gefilterde, live doelgroep: alleen status "device", optioneel op model.
# - Naam op serienummer (ro.serialno), anders op IP; zie load_devices_file.
# - Hangt een device zowel aan USB als aan wifi, dan telt het één keer, via
#   wifi (twee pushes tegelijk naar één device = corrupt pack).
# - Bekend device op een nieuw IP: devices.txt wordt bijgewerkt, net als een
#   ontbrekend serienummer bij een device dat op IP herkend werd.
T_SERIAL=(); T_NAME=(); T_MODEL=(); T_RELEASE=(); T_ABI=(); T_HW=()
list_targets(){
  local model_filter="${1:-}"
  T_SERIAL=(); T_NAME=(); T_MODEL=(); T_RELEASE=(); T_ABI=(); T_HW=()
  load_devices_file
  scan_adb_devices
  local i j serial status ip name model release abi hw dup idx
  for i in "${!ALL_SERIALS[@]}"; do
    serial="${ALL_SERIALS[$i]}"; status="${ALL_STATUS[$i]}"
    [ "$status" = "device" ] || continue
    model="$(get_prop "$serial" ro.product.model)"
    release="$(get_prop "$serial" ro.build.version.release)"
    abi="$(get_prop "$serial" ro.product.cpu.abi)"
    hw="$(get_prop "$serial" ro.serialno)"
    if [ -n "$model_filter" ]; then
      case "$model" in
        *"$model_filter"*) : ;;
        *) continue ;;
      esac
    fi
    ip="${serial%%:*}"

    # zelfde device al gezien (usb + wifi)? dan wifi houden
    dup=-1
    if [ -n "$hw" ]; then
      for j in "${!T_HW[@]}"; do
        [ "${T_HW[$j]}" = "$hw" ] && { dup="$j"; break; }
      done
    fi

    name="$(resolve_name "$hw" "$ip")"
    if [ "$name" != "-" ] && [ "$serial" != "$ip" ]; then
      idx="$(idx_for_name "$name")"
      if [ "${DEV_IPS[$idx]}" != "$ip" ] || [ -z "${DEV_SNS[$idx]}" ]; then
        [ "${DEV_IPS[$idx]}" != "$ip" ] && info "$name: nieuw IP ${DEV_IPS[$idx]} -> $ip (devices.txt bijgewerkt)" >&2
        update_device_entry "$name" "$ip" "$hw"
      fi
    fi
    [ "$serial" = "$ip" ] && [ "$name" = "-" ] && name="usb"

    if [ "$dup" -ge 0 ]; then
      if [ "$serial" != "$ip" ]; then
        T_SERIAL[$dup]="$serial"; T_NAME[$dup]="$name"
      fi
      warn "$name (${hw}) hangt aan USB en wifi — telt één keer, via wifi"
      continue
    fi
    T_SERIAL+=("$serial"); T_NAME+=("$name"); T_MODEL+=("$model"); T_RELEASE+=("$release"); T_ABI+=("$abi"); T_HW+=("$hw")
  done
}

report_skipped(){
  local s
  if [ "${#OFFLINE_SERIALS[@]}" -gt 0 ]; then
    for s in "${OFFLINE_SERIALS[@]}"; do
      warn "overgeslagen (offline): $s ($(name_for_ip "${s%%:*}" ""))"
    done
  fi
  if [ "${#UNAUTH_SERIALS[@]}" -gt 0 ]; then
    for s in "${UNAUTH_SERIALS[@]}"; do
      warn "overgeslagen (unauthorized): $s ($(name_for_ip "${s%%:*}" ""))"
    done
  fi
}

# ============================================================
# lokale bestandslijst (relatief aan pack-dir)
# ============================================================
REL_FILES=()
build_local_file_list(){
  local dir="$1" f
  REL_FILES=()
  while IFS= read -r f || [ -n "$f" ]; do
    REL_FILES+=("${f#$dir/}")
  done < <(find "$dir" -type f ! -name '.DS_Store' -print | LC_ALL=C sort)
}

# ============================================================
# verify: manifest byte-diff + bestandslijst in 1 round-trip
# ============================================================
verify_manifest(){
  local serial="$1" local_manifest="$2" remote_dir="$3" out
  out="$TMPDIR_ZS/$(sanitize "$serial").manifest"
  adb -s "$serial" exec-out cat "$remote_dir/manifest.json" </dev/null > "$out" 2>/dev/null || true
  cmp -s "$local_manifest" "$out"
}

verify_files_present(){
  local serial="$1" remote_dir="$2" list="" script out rc=0
  [ "${#REL_FILES[@]}" -gt 0 ] && list="$(printf '%s ' "${REL_FILES[@]}")"
  script="cd '$remote_dir' 2>/dev/null || exit 9; for f in $list; do [ -f \"\$f\" ] || echo MISSING \$f; done"
  out="$(adb -s "$serial" shell "$script" </dev/null 2>/dev/null | tr -d '\r')" || rc=$?
  if [ "$rc" -ne 0 ]; then
    printf 'ADB-fout: device onbereikbaar tijdens verify\n'
    return 1
  fi
  [ -z "$out" ] || { printf '%s\n' "$out"; return 1; }
  return 0
}

count_present_files(){
  local serial="$1" remote_dir="$2" list="" script out rc=0
  [ "${#REL_FILES[@]}" -gt 0 ] && list="$(printf '%s ' "${REL_FILES[@]}")"
  script="cd '$remote_dir' 2>/dev/null || exit 0; for f in $list; do [ -f \"\$f\" ] && echo P; done"
  out="$(adb -s "$serial" shell "$script" </dev/null 2>/dev/null | tr -d '\r')" || rc=$?
  [ "$rc" -eq 0 ] || { printf '0'; return 0; }
  printf '%s' "$out" | grep -c '^P' || true
}

get_remote_manifest_version(){
  local serial="$1" raw
  raw="$(adb -s "$serial" exec-out cat "$REMOTE_PACK/manifest.json" </dev/null 2>/dev/null || true)"
  [ -n "$raw" ] || { printf ''; return 0; }
  printf '%s' "$raw" \
    | grep -oE '"(version|versie)"[[:space:]]*:[[:space:]]*("[^"]*"|-?[0-9]+(\.[0-9]+)?)' \
    | head -1 \
    | sed -E 's/^"[a-zA-Z]+"[[:space:]]*:[[:space:]]*//' \
    | tr -d '"' || true
  return 0
}

# ============================================================
# atomische swap: pack -> .pack_old, .staging -> pack, .pack_old weg
# ============================================================
do_swap(){
  local serial="$1" had_old="N" rc=0
  had_old="$(adb -s "$serial" shell "[ -d '$REMOTE_PACK' ] && echo Y || echo N" </dev/null 2>/dev/null | tr -d '\r\n')" || rc=$?
  if [ "$rc" -ne 0 ]; then
    echo "swap: kon niet controleren of er al een pack stond"
    return 1
  fi
  if [ "$had_old" = "Y" ]; then
    if ! adb -s "$serial" shell "mv '$REMOTE_PACK' '$REMOTE_PACK_OLD'" </dev/null >/dev/null 2>&1; then
      echo "swap: kon oude pack niet naar .pack_old zetten"
      return 1
    fi
  fi
  if ! adb -s "$serial" shell "mv '$REMOTE_STAGING' '$REMOTE_PACK'" </dev/null >/dev/null 2>&1; then
    echo "swap: kon staging niet activeren, oude pack herstellen"
    [ "$had_old" = "Y" ] && adb -s "$serial" shell "mv '$REMOTE_PACK_OLD' '$REMOTE_PACK'" </dev/null >/dev/null 2>&1 || true
    return 1
  fi
  adb -s "$serial" shell "rm -rf '$REMOTE_PACK_OLD'" </dev/null >/dev/null 2>&1 || true
  return 0
}

# ============================================================
# push: 1 device
# ============================================================
push_one_device(){
  local serial="$1" name="$2" pack_dir="$3" local_manifest="$4" logf="$5" resf="$6"
  local missing_out files_ok swap_msg swap_ok
  {
    echo "== $name ($serial) =="
    adb -s "$serial" shell "mkdir -p '$REMOTE_BASE'" </dev/null >/dev/null 2>&1 || true

    echo "-> staging opruimen"
    if ! adb -s "$serial" shell "rm -rf '$REMOTE_STAGING'" </dev/null >/dev/null 2>&1; then
      echo "kon .staging niet opruimen"
      printf 'STATUS=FAIL\nREASON=staging-cleanup\n' > "$resf"
      return 1
    fi

    echo "-> push $pack_dir -> $REMOTE_STAGING"
    if ! adb -s "$serial" push "$pack_dir" "$REMOTE_STAGING" </dev/null >/dev/null 2>&1; then
      echo "adb push gefaald"
      adb -s "$serial" shell "rm -rf '$REMOTE_STAGING'" </dev/null >/dev/null 2>&1 || true
      printf 'STATUS=FAIL\nREASON=push\n' > "$resf"
      return 1
    fi

    if [ "$local_manifest" != "$pack_dir/manifest.json" ]; then
      echo "-> story: $local_manifest -> manifest.json"
      if ! adb -s "$serial" push "$local_manifest" "$REMOTE_STAGING/manifest.json" </dev/null >/dev/null 2>&1; then
        echo "story-manifest push gefaald"
        adb -s "$serial" shell "rm -rf '$REMOTE_STAGING'" </dev/null >/dev/null 2>&1 || true
        printf 'STATUS=FAIL\nREASON=story-push\n' > "$resf"
        return 1
      fi
    fi

    echo "-> verify manifest.json (byte-diff)"
    if ! verify_manifest "$serial" "$local_manifest" "$REMOTE_STAGING"; then
      echo "manifest.json komt niet overeen"
      adb -s "$serial" shell "rm -rf '$REMOTE_STAGING'" </dev/null >/dev/null 2>&1 || true
      printf 'STATUS=FAIL\nREASON=manifest-diff\n' > "$resf"
      return 1
    fi

    echo "-> verify bestandslijst (${#REL_FILES[@]} bestanden, 1 round-trip)"
    missing_out="$(verify_files_present "$serial" "$REMOTE_STAGING")" && files_ok=1 || files_ok=0
    if [ "$files_ok" -eq 0 ]; then
      echo "ontbrekende bestanden op device:"
      echo "$missing_out"
      adb -s "$serial" shell "rm -rf '$REMOTE_STAGING'" </dev/null >/dev/null 2>&1 || true
      printf 'STATUS=FAIL\nREASON=missing-files\n' > "$resf"
      return 1
    fi

    echo "-> swap staging -> pack"
    swap_msg="$(do_swap "$serial")" && swap_ok=1 || swap_ok=0
    if [ "$swap_ok" -eq 0 ]; then
      echo "$swap_msg"
      printf 'STATUS=FAIL\nREASON=swap\n' > "$resf"
      return 1
    fi

    echo "OK"
    printf 'STATUS=OK\nFILES=%s\n' "${#REL_FILES[@]}" > "$resf"
    return 0
  } > "$logf" 2>&1
  return 0
}

print_push_table(){
  info ""
  info "${C_BOLD}resultaat${C_RST}"
  printf '%-12s %-18s %-8s %s\n' "NAAM" "SERIAL" "STATUS" "DETAIL"
  local i serial resf status reason failcount=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"
    resf="$TMPDIR_ZS/$(sanitize "$serial").res"
    status="FAIL"; reason="geen resultaat"
    if [ -f "$resf" ]; then
      status="$(awk -F= '$1=="STATUS"{print $2}' "$resf")"
      reason="$(awk -F= '$1=="REASON"{print $2}' "$resf")"
    fi
    if [ "$status" = "OK" ]; then
      printf '%-12s %-18s %s%-8s%s %s\n' "${T_NAME[$i]}" "$serial" "$C_GRN" "OK" "$C_RST" "ok"
    else
      failcount=$((failcount+1))
      printf '%-12s %-18s %s%-8s%s %s\n' "${T_NAME[$i]}" "$serial" "$C_RED" "FAILED" "$C_RST" "$reason"
    fi
  done
  return "$failcount"
}

cmd_push(){
  local pack_dir="$PACK_DIR_DEFAULT" model_filter="" parallel=0 dryrun=0 restart=0
  local args=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --parallel) parallel=1 ;;
      --dry-run) dryrun=1 ;;
      --restart) restart=1 ;;
      --model) shift; model_filter="${1:-}" ;;
      -*) err "onbekende optie: $1"; exit 1 ;;
      *) args+=("$1") ;;
    esac
    shift
  done
  [ "${#args[@]}" -ge 1 ] && pack_dir="${args[0]}"

  [ -d "$pack_dir" ] || { err "pack-dir niet gevonden: $pack_dir"; exit 1; }
  local local_manifest="$pack_dir/manifest.json"
  [ -f "$local_manifest" ] || { err "geen manifest.json in $pack_dir"; exit 1; }

  build_local_file_list "$pack_dir"
  list_targets "$model_filter"
  report_skipped
  [ "${#T_SERIAL[@]}" -eq 0 ] && { err "geen devices met status 'device' gevonden (na filter)."; exit 1; }

  # per device het manifest van zijn story; ontbreekt er een, dan niets pushen
  local i T_MANIFEST=() story dev_manifest
  for i in "${!T_SERIAL[@]}"; do
    story="$(story_for_name "${T_NAME[$i]}")"
    dev_manifest="$(manifest_for_story "$story" "$pack_dir")"
    [ -f "$dev_manifest" ] || { err "${T_NAME[$i]}: story '$story' niet gevonden ($dev_manifest)"; exit 1; }
    T_MANIFEST+=("$dev_manifest")
  done

  info "${C_BOLD}push${C_RST}: $pack_dir -> ${#T_SERIAL[@]} device(s), ${#REL_FILES[@]} bestand(en)"

  if [ "$dryrun" -eq 1 ]; then
    info "DRY RUN — geen device wordt aangeraakt."
    for i in "${!T_SERIAL[@]}"; do
      info "  zou pushen naar: ${T_NAME[$i]} (${T_SERIAL[$i]}, ${T_MODEL[$i]}) — story $(story_for_name "${T_NAME[$i]}")"
    done
    exit 0
  fi

  local serial name logf resf pids=()
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"; name="${T_NAME[$i]}"
    logf="$TMPDIR_ZS/$(sanitize "$serial").log"
    resf="$TMPDIR_ZS/$(sanitize "$serial").res"
    if [ "$parallel" -eq 1 ]; then
      push_one_device "$serial" "$name" "$pack_dir" "${T_MANIFEST[$i]}" "$logf" "$resf" &
      pids+=("$!")
    else
      push_one_device "$serial" "$name" "$pack_dir" "${T_MANIFEST[$i]}" "$logf" "$resf" || true
      cat "$logf"
    fi
  done

  if [ "$parallel" -eq 1 ]; then
    local p
    if [ "${#pids[@]}" -gt 0 ]; then
      for p in "${pids[@]}"; do wait "$p" || true; done
    fi
    for i in "${!T_SERIAL[@]}"; do
      serial="${T_SERIAL[$i]}"
      cat "$TMPDIR_ZS/$(sanitize "$serial").log"
    done
  fi

  [ "$restart" -eq 1 ] && { restart_targets "$model_filter" || true; }

  if print_push_table; then exit 0; else exit 1; fi
}

# ============================================================
# status
# ============================================================
VERS=(); PRESENT_COUNTS=()

print_status_table_full(){
  local consensus="$1" expected="$2"
  info ""
  info "${C_BOLD}status${C_RST} (verwacht: ${expected} bestand(en) uit $PACK_DIR_DEFAULT/, consensus versie: ${consensus:-onbekend})"
  printf '%-12s %-18s %-10s %-8s %-8s %-12s %s\n' "NAAM" "SERIAL" "MODEL" "ANDROID" "VERSIE" "BESTANDEN" "PACK"
  local i serial ver present state any_mismatch=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"; ver="${VERS[$i]}"; present="${PRESENT_COUNTS[$i]}"
    if [ -z "$ver" ]; then
      state="${C_RED}GEEN PACK${C_RST}"; any_mismatch=1
    elif [ -n "$present" ] && [ "$expected" -gt 0 ] && [ "$present" -ne "$expected" ]; then
      state="${C_YLW}AFWIJKEND${C_RST}"; any_mismatch=1
    elif [ -n "$consensus" ] && [ "$ver" != "$consensus" ]; then
      state="${C_YLW}AFWIJKEND${C_RST}"; any_mismatch=1
    else
      state="${C_GRN}OK${C_RST}"
    fi
    printf '%-12s %-18s %-10s %-8s %-8s %-12s %b\n' \
      "${T_NAME[$i]}" "$serial" "${T_MODEL[$i]}" "${T_RELEASE[$i]}" "${ver:--}" "${present:--}/${expected}" "$state"
  done
  [ "$any_mismatch" -eq 1 ] && { warn "niet alle devices draaien dezelfde versie / hebben een compleet pack."; return 1; }
  ok "alle devices op consensus-versie '${consensus}' met compleet pack."
  return 0
}

cmd_status(){
  local model_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) shift; model_filter="${1:-}" ;;
      *) err "onbekende optie: $1"; exit 1 ;;
    esac
    shift
  done

  local pack_dir="$PACK_DIR_DEFAULT"
  if [ -d "$pack_dir" ]; then build_local_file_list "$pack_dir"; else REL_FILES=(); fi
  local expected_count="${#REL_FILES[@]}"

  list_targets "$model_filter"
  report_skipped
  [ "${#T_SERIAL[@]}" -eq 0 ] && { err "geen devices gevonden."; exit 1; }

  local i serial ver present
  VERS=(); PRESENT_COUNTS=()
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"
    ver="$(get_remote_manifest_version "$serial")"
    VERS+=("$ver")
    if [ "$expected_count" -gt 0 ] && [ -n "$ver" ]; then
      present="$(count_present_files "$serial" "$REMOTE_PACK")"
    else
      present=""
    fi
    PRESENT_COUNTS+=("$present")
  done

  local consensus=""
  if [ "${#VERS[@]}" -gt 0 ]; then
    consensus="$(printf '%s\n' "${VERS[@]}" | grep -v '^$' | LC_ALL=C sort | uniq -c | LC_ALL=C sort -rn | head -1 | awk '{print $2}' || true)"
  fi

  if print_status_table_full "$consensus" "$expected_count"; then exit 0; else exit 1; fi
}

# ============================================================
# devices
# ============================================================
cmd_devices(){
  local model_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in --model) shift; model_filter="${1:-}" ;; *) err "onbekende optie: $1"; exit 1 ;; esac
    shift
  done
  load_devices_file
  scan_adb_devices
  info "${C_BOLD}devices${C_RST} (adb devices, gekoppeld aan $DEVICES_FILE)"
  printf '%-20s %-10s %-14s %-10s %-8s %s\n' "SERIAL" "NAAM" "STATUS" "MODEL" "ANDROID" "SERIENUMMER"
  local i serial status ip name model release hw unknown=0
  for i in "${!ALL_SERIALS[@]}"; do
    serial="${ALL_SERIALS[$i]}"; status="${ALL_STATUS[$i]}"
    ip="${serial%%:*}"
    if [ "$status" = "device" ]; then
      model="$(get_prop "$serial" ro.product.model)"
      release="$(get_prop "$serial" ro.build.version.release)"
      hw="$(get_prop "$serial" ro.serialno)"
      if [ -n "$model_filter" ]; then
        case "$model" in *"$model_filter"*) : ;; *) continue ;; esac
      fi
      name="$(resolve_name "$hw" "$ip")"
      [ "$name" = "-" ] && [ "$serial" != "$ip" ] && unknown=$((unknown+1))
      printf '%-20s %-10s %s%-14s%s %-10s %-8s %s\n' "$serial" "$name" "$C_GRN" "$status" "$C_RST" "$model" "$release" "$hw"
    else
      [ -n "$model_filter" ] && continue
      name="$(name_for_ip "$ip" "")"
      printf '%-20s %-10s %s%-14s%s %-10s %-8s %s\n' "$serial" "$name" "$C_YLW" "$status" "$C_RST" "-" "-" "-"
    fi
  done
  [ "$unknown" -gt 0 ] && info "$unknown device(s) zonder naam — geef ze er een met: $SCRIPT_NAME adopt"
  return 0
}

# ============================================================
# adopt: onbekende live devices een naam + serienummer geven
# ============================================================
# Hergebruikt eerst "dode" regels uit devices.txt (geen serienummer, IP niet
# meer live, zelfde soort: mc voor MC18N0, ps voor PS20J), daarna mcN/psN.
# Welke fysieke scanner welke oude naam krijgt is dan willekeurig, maar vanaf
# nu blijft de koppeling vast (op serienummer).
cmd_adopt(){
  list_targets ""
  local i j serial ip prefix name cand live_ips="" n adopted=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"; ip="${serial%%:*}"
    [ "$serial" != "$ip" ] && live_ips="$live_ips $ip "
  done
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"; ip="${serial%%:*}"
    [ "${T_NAME[$i]}" = "-" ] || continue
    [ "$serial" != "$ip" ] || continue # alleen wifi: devices.txt heeft een IP nodig
    case "${T_MODEL[$i]}" in PS*) prefix="ps" ;; *) prefix="mc" ;; esac
    name=""
    for j in "${!DEV_NAMES[@]}"; do
      cand="${DEV_NAMES[$j]}"
      case "$cand" in "$prefix"[0-9]*) : ;; *) continue ;; esac
      [ -z "${DEV_SNS[$j]}" ] || continue
      case "$live_ips" in *" ${DEV_IPS[$j]} "*) continue ;; esac
      name="$cand"; break
    done
    if [ -z "$name" ]; then
      n=1
      while [ "$(idx_for_name "$prefix$n")" != "-1" ]; do n=$((n+1)); done
      name="$prefix$n"
    fi
    update_device_entry "$name" "$ip" "${T_HW[$i]}"
    T_NAME[$i]="$name"
    ok "$name -> $ip (sn ${T_HW[$i]}, ${T_MODEL[$i]})"
    adopted=$((adopted+1))
  done
  [ "$adopted" -eq 0 ] && info "alle live devices hebben al een naam."
  return 0
}

# ============================================================
# pair / connect
# ============================================================
cmd_pair(){
  local name="${1:-}"
  [ -n "$name" ] || { err "gebruik: $SCRIPT_NAME pair <naam>"; exit 1; }

  info "pair: adb -d tcpip $ADB_PORT"
  if ! adb -d tcpip "$ADB_PORT" </dev/null > "$TMPDIR_ZS/pair.log" 2>&1; then
    err "adb -d tcpip gefaald (0 of >1 USB devices verbonden?)"
    cat "$TMPDIR_ZS/pair.log" >&2
    exit 1
  fi
  sleep 2

  local ip_line ip_addr
  ip_line="$(adb -d shell ip -f inet addr show wlan0 </dev/null 2>/dev/null || true)"
  ip_addr="$(printf '%s' "$ip_line" | awk '/inet /{print $2}' | head -1 | cut -d/ -f1)"
  if [ -z "$ip_addr" ]; then
    ip_addr="$(adb -d shell getprop dhcp.wlan0.ipaddress </dev/null 2>/dev/null | tr -d '\r\n')" || true
  fi
  if [ -z "$ip_addr" ]; then
    warn "kon geen wifi-IP uitlezen ('ip addr show wlan0' EN 'getprop dhcp.wlan0.ipaddress' beide leeg)."
    warn "is wifi verbonden op het device?"
    exit 1
  fi

  info "wifi-IP: $ip_addr"
  local hw
  hw="$(adb -d shell getprop ro.serialno </dev/null 2>/dev/null | tr -d '\r\n')" || true
  update_device_entry "$name" "$ip_addr" "$hw"

  ok "'$name' -> $ip_addr:$ADB_PORT (sn ${hw:-?}) weggeschreven in $DEVICES_FILE"
  info "kabel kan eruit. draai nu: $SCRIPT_NAME connect"
}

cmd_connect(){
  load_devices_file
  [ "${#DEV_NAMES[@]}" -eq 0 ] && { err "$DEVICES_FILE leeg of niet gevonden. Draai eerst: $SCRIPT_NAME pair <naam>"; exit 1; }
  local i n ip out rc=0
  for i in "${!DEV_NAMES[@]}"; do
    n="${DEV_NAMES[$i]}"; ip="${DEV_IPS[$i]}"
    out="$(adb connect "${ip}:${ADB_PORT}" </dev/null 2>&1 || true)"
    case "$out" in
      *"connected to"*|*"already connected"*) ok "$n ($ip): $out" ;;
      *) err "$n ($ip): $out"; rc=1 ;;
    esac
  done
  exit "$rc"
}

# ============================================================
# install
# ============================================================
cmd_install(){
  local apk="" model_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --model) shift; model_filter="${1:-}" ;;
      -*) err "onbekende optie: $1"; exit 1 ;;
      *) apk="$1" ;;
    esac
    shift
  done
  [ -n "$apk" ] || { err "gebruik: $SCRIPT_NAME install <apk> [--model x]"; exit 1; }
  [ -f "$apk" ] || { err "apk niet gevonden: $apk"; exit 1; }

  local apk_abis
  apk_abis="$(unzip -l "$apk" 2>/dev/null | grep -oE 'lib/[^/]+/' | LC_ALL=C sort -u | tr -d '/' | sed 's#^lib##' || true)"

  list_targets "$model_filter"
  report_skipped
  [ "${#T_SERIAL[@]}" -eq 0 ] && { err "geen devices gevonden."; exit 1; }

  if [ "${#T_SERIAL[@]}" -gt 1 ]; then
    warn "installeren op ${#T_SERIAL[@]} devices — zeldzame/dure actie."
    read -r -p "doorgaan? [y/N] " answer || answer=""
    case "$answer" in y|yes) ;; *) info "geannuleerd."; exit 1 ;; esac
  fi

  local i serial dev_abi rc=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"
    dev_abi="${T_ABI[$i]}"
    if [ -n "$apk_abis" ]; then
      case "$apk_abis" in
        *"$dev_abi"*) info "[${T_NAME[$i]}] device abi=$dev_abi, apk abi's: $(printf '%s' "$apk_abis" | tr '\n' ' ') (match)" ;;
        *) warn "[${T_NAME[$i]}] device abi=$dev_abi komt niet voor in apk abi's: $(printf '%s' "$apk_abis" | tr '\n' ' ')" ;;
      esac
    else
      info "[${T_NAME[$i]}] device abi=$dev_abi (apk heeft geen native libs, of abi kon niet gelezen worden)"
    fi
    info "-> adb install -r naar ${T_NAME[$i]} ($serial)"
    local ilog="$TMPDIR_ZS/install_$(sanitize "$serial").log"
    if adb -s "$serial" install -r "$apk" </dev/null > "$ilog" 2>&1 && grep -qi "^Success" "$ilog"; then
      ok "[${T_NAME[$i]}] geinstalleerd"
    else
      err "[${T_NAME[$i]}] install gefaald: $(tail -1 "$ilog")"
      rc=1
    fi
  done
  exit "$rc"
}

# ============================================================
# restart
# ============================================================
restart_targets(){
  local model_filter="${1:-}"
  [ -n "$ZS_APP_ID" ] || { err "ZS_APP_ID niet gezet. Zet 'm bovenin het script of: ZS_APP_ID=com.jouw.pkg $SCRIPT_NAME restart"; return 1; }

  list_targets "$model_filter"
  report_skipped
  [ "${#T_SERIAL[@]}" -eq 0 ] && { err "geen devices gevonden."; return 1; }

  local i serial path rc=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"
    path="$(adb -s "$serial" shell pm path "$ZS_APP_ID" </dev/null 2>/dev/null | tr -d '\r')" || true
    if [ -z "$path" ]; then
      err "[${T_NAME[$i]}] app $ZS_APP_ID niet geinstalleerd"; rc=1; continue
    fi
    adb -s "$serial" shell am force-stop "$ZS_APP_ID" </dev/null >/dev/null 2>&1 || true
    if adb -s "$serial" shell monkey -p "$ZS_APP_ID" -c android.intent.category.LAUNCHER 1 </dev/null >/dev/null 2>&1; then
      ok "[${T_NAME[$i]}] herstart"
    else
      err "[${T_NAME[$i]}] relaunch gefaald"; rc=1
    fi
  done
  return "$rc"
}

cmd_restart(){
  local model_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in --model) shift; model_filter="${1:-}" ;; *) err "onbekende optie: $1"; exit 1 ;; esac
    shift
  done
  restart_targets "$model_filter"
  exit $?
}

shutdown_targets(){
  local model_filter="${1:-}"

  list_targets "$model_filter"
  report_skipped
  [ "${#T_SERIAL[@]}" -eq 0 ] && { err "geen devices gevonden."; return 1; }

  local i serial rc=0
  for i in "${!T_SERIAL[@]}"; do
    serial="${T_SERIAL[$i]}"
    if adb -s "$serial" shell reboot -p </dev/null >/dev/null 2>&1; then
      ok "[${T_NAME[$i]}] uitgezet — weer aan: fysieke powerknop"
    else
      err "[${T_NAME[$i]}] uitzetten gefaald"; rc=1
    fi
  done
  return "$rc"
}

cmd_shutdown(){
  local model_filter=""
  while [ $# -gt 0 ]; do
    case "$1" in --model) shift; model_filter="${1:-}" ;; *) err "onbekende optie: $1"; exit 1 ;; esac
    shift
  done
  shutdown_targets "$model_filter"
  exit $?
}

# ============================================================
# usage + dispatch
# ============================================================
usage(){
  cat <<EOF
$SCRIPT_NAME — deploy zelfscanner content-pack + app naar Zebra devices (MC18N0 / PS20J) via adb/wifi

gebruik:
  $SCRIPT_NAME pair <naam>            koppel het USB-verbonden device, schrijf naam+ip in $DEVICES_FILE
  $SCRIPT_NAME connect                adb connect naar alle devices in $DEVICES_FILE
  $SCRIPT_NAME devices                toon wat adb ziet + naam/model/android-versie/serienummer
  $SCRIPT_NAME adopt                  geef live devices zonder naam een naam + serienummer in $DEVICES_FILE
  $SCRIPT_NAME push [pack-dir]        push content-pack (default: $PACK_DIR_DEFAULT/), atomische swap
  $SCRIPT_NAME status                 versie + bestandscount per device, vlagt afwijkingen
  $SCRIPT_NAME install <apk>          adb install -r naar alle (gefilterde) devices
  $SCRIPT_NAME restart                force-stop + relaunch app (\$ZS_APP_ID)
  $SCRIPT_NAME shutdown               zet device(s) uit (adb reboot -p) — weer aan: powerknop

opties (waar van toepassing):
  --model <substr>     filter op ro.product.model (bv. MC18, PS20)
  --parallel           (push) devices in de achtergrond, gebundelde output achteraf
  --dry-run            (push) laat zien wat er zou gebeuren, raakt niets aan
  --restart            (push) restart de app na een succesvolle push

env:
  ZS_APP_ID             package-naam van de app (nu: ${ZS_APP_ID:-<niet gezet>})

let op:
  'adb tcpip' overleeft GEEN reboot van het device. Na een herstart moet je
  opnieuw 'pair' via USB draaien. Mogelijke persist-optie op stock AOSP is
  'setprop persist.adb.tcp.port $ADB_PORT' (adbd start dan bij boot al in
  tcp-mode) — op deze Zebra-builds ONBEVESTIGD of shell dat mag zetten,
  probeer het zelf en vertrouw er niet blind op.
EOF
}

main(){
  require_adb
  load_devices_file
  local cmd="${1:-}"
  [ $# -gt 0 ] && shift
  case "$cmd" in
    pair) cmd_pair "$@" ;;
    connect) cmd_connect "$@" ;;
    devices) cmd_devices "$@" ;;
    adopt) cmd_adopt "$@" ;;
    push) cmd_push "$@" ;;
    status) cmd_status "$@" ;;
    install) cmd_install "$@" ;;
    restart) cmd_restart "$@" ;;
    shutdown) cmd_shutdown "$@" ;;
    -h|--help|help|"") usage ;;
    *) err "onbekend subcommando: $cmd"; usage; exit 1 ;;
  esac
}

main "$@"
